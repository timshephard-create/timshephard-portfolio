{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/interview", "permanent": true },
    { "source": "/nonprofit", "destination": "/work", "permanent": true },
    { "source": "/gov", "destination": "/work", "permanent": true },
    { "source": "/entertainment", "destination": "/work", "permanent": true },
    { "source": "/tech", "destination": "/work", "permanent": true },
    { "source": "/branding", "destination": "/work", "permanent": true },
    { "source": "/gaming", "destination": "/ventures", "permanent": true },
    { "source": "/projects", "destination": "/ventures", "permanent": true },
    { "source": "/recommendations", "destination": "/hire", "permanent": true },
    { "source": "/explore", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
